# ============================================
# MARIA Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================

# --- General ---
MARIA_ENV=development
MARIA_LOG_LEVEL=INFO
MARIA_HOST=127.0.0.1
MARIA_PORT=8000

# --- AI Providers (BYOK - Bring Your Own Key) ---
# Uncomment and fill in only the providers you want to use.

# Google Gemini
# GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI
# OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenRouter
# OPENROUTER_API_KEY=your-openrouter-api-key-here

# Ollama (local - no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434

# --- Security ---
# MARIA_MASTER_KEY=  # Leave empty to use OS keyring (recommended)

# --- Database ---
# MARIA_DB_PATH=~/.maria/maria.db
